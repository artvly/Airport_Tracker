# Скопируйте этот файл в .env (в этой же папке) и заполните значения.
# Файл .env в git не попадает.

# Секретный ключ Django. Сгенерировать:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# Подключение к PostgreSQL (localhost:5432)
DB_NAME=dj_db
DB_USER=
DB_PASSWORD=

# Учётная запись OpenSky Network (необязательно: без неё действуют строгие лимиты анонимного доступа)
OpenSky_username=
OpenSky_password=
